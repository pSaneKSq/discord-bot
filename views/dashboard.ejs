<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= siteSettings.siteName || 'Dashboard' %> — Ticket System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/utils.js"></script>
    <style>
        /* Настраиваемый акцентный цвет сайта — управляется из "Настроек" (только владелец) */
        :root {
            --accent-color: <%= siteSettings.accentColor %>;
            --accent-color-secondary: <%= siteSettings.accentColorSecondary %>;
        }
        .text-accent { color: var(--accent-color) !important; }
        .btn-accent, .bg-accent { background-color: var(--accent-color) !important; }
        .border-accent { border-color: var(--accent-color) !important; }
        .nav-pills .nav-link.active {
            background-color: var(--accent-color) !important;
            color: #fff !important;
        }
        .form-check-input:checked {
            background-color: var(--accent-color) !important;
            border-color: var(--accent-color) !important;
        }
        .form-range::-webkit-slider-thumb { background-color: var(--accent-color) !important; }
    </style>
</head>
<body class="bg-dark text-light overflow-x-hidden">

<div class="space-bg">
    <div class="nebula"></div>
    <div class="stars-far"></div>
    <div class="stars-mid"></div>
    <div class="stars"></div>
    <div class="comet comet-1"></div>
    <div class="comet comet-2"></div>
    <div class="comet comet-3"></div>
    <div class="comet comet-4"></div>
    <div class="comet comet-5"></div>
</div>

<div class="d-flex min-vh-100 position-relative z-1">
    <!-- Sidebar -->
    <div class="sidebar p-3 d-flex flex-column justify-content-between border-end border-secondary-subtle">
        <div>
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <i class="bi bi-stars text-accent fs-4"></i>
                <h4 class="fw-bold mb-0 text-white"><%= siteSettings.siteName || 'Dashboard' %></h4>
            </div>

            <% if (isOwner) { %>
            <div class="text-muted small fw-bold px-2 mb-2 text-uppercase">Сайт клана</div>
            <div class="nav flex-column nav-pills gap-1 mb-4">
                <a href="/dashboard?tab=clan" class="nav-link <%= activeTab === 'ownerClan' ? 'active' : '' %> text-start"><i class="bi bi-flag me-2"></i>Страница клана</a>
                <a href="/" target="_blank" class="nav-link text-start"><i class="bi bi-box-arrow-up-right me-2"></i>Открыть сайт</a>
            </div>
            <% } %>

            <div class="text-muted small fw-bold px-2 mb-2 text-uppercase">Система тикетов</div>
            <div class="nav flex-column nav-pills gap-1 mb-4">
                <a href="/forms" class="nav-link <%= activeTab === 'tickets/forms' || activeTab === 'tickets/editForm' ? 'active' : '' %> text-start">
                    <i class="bi bi-ui-checks me-2"></i>Формы заявок
                </a>
                <a href="/dashboard?tab=applications" class="nav-link <%= activeTab === 'tickets/applications' ? 'active' : '' %> text-start">
                    <i class="bi bi-clipboard-data me-2"></i>История заявок
                </a>
            </div>

            <div class="text-muted small fw-bold px-2 mb-2 text-uppercase">Оповещения</div>
            <div class="nav flex-column nav-pills gap-1 mb-4">
                <a href="/dashboard?tab=embed" class="nav-link <%= activeTab === 'embed' ? 'active' : '' %> text-start">
                    <i class="bi bi-megaphone me-2"></i>Конструктор объявлений
                </a>
                <a href="/dashboard?tab=polls" class="nav-link <%= activeTab === 'notifications/polls' ? 'active' : '' %> text-start">
                    <i class="bi bi-bar-chart-steps me-2"></i>Опросы
                </a>
                <a href="/dashboard?tab=reactionRoles" class="nav-link <%= activeTab === 'notifications/reactionRoles' ? 'active' : '' %> text-start">
                    <i class="bi bi-emoji-smile me-2"></i>Автороли
                </a>
                <a href="/dashboard?tab=levels" class="nav-link <%= activeTab === 'notifications/levels' ? 'active' : '' %> text-start">
                    <i class="bi bi-trophy me-2"></i>Уровни
                </a>
                <a href="/dashboard?tab=sounds" class="nav-link <%= activeTab === 'notifications/sounds' ? 'active' : '' %> text-start">
                    <i class="bi bi-volume-up me-2"></i>Звуковые оповещения
                </a>
            </div>

            <div class="text-muted small fw-bold px-2 mb-2 text-uppercase">Аналитика</div>
            <div class="nav flex-column nav-pills gap-1 mb-4">
                <a href="/dashboard?tab=stats" class="nav-link <%= activeTab === 'tickets/stats' ? 'active' : '' %> text-start">
                    <i class="bi bi-graph-up-arrow me-2"></i>Статистика
                </a>
                <a href="/dashboard?tab=member" class="nav-link <%= activeTab === 'analytics/member' ? 'active' : '' %> text-start">
                    <i class="bi bi-person-badge me-2"></i>Досье участника
                </a>
                <a href="/dashboard?tab=weeklyReport" class="nav-link <%= activeTab === 'analytics/weeklyReport' ? 'active' : '' %> text-start">
                    <i class="bi bi-calendar-week me-2"></i>Еженедельный отчёт
                </a>
                <a href="/dashboard?tab=swearWords" class="nav-link <%= activeTab === 'analytics/swearWords' ? 'active' : '' %> text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>Список матов
                </a>
            </div>

            <div class="text-muted small fw-bold px-2 mb-2 text-uppercase">Модерация</div>
            <div class="nav flex-column nav-pills gap-1 mb-4">
                <a href="/dashboard?tab=modLogs" class="nav-link <%= activeTab === 'moderation/logs' ? 'active' : '' %> text-start">
                    <i class="bi bi-journal-text me-2"></i>Журнал
                </a>
                <a href="/dashboard?tab=modSettings" class="nav-link <%= activeTab === 'moderation/settings' ? 'active' : '' %> text-start">
                    <i class="bi bi-shield-lock me-2"></i>Настройки логов
                </a>
                <a href="/dashboard?tab=warnings" class="nav-link <%= activeTab === 'moderation/warnings' ? 'active' : '' %> text-start">
                    <i class="bi bi-exclamation-triangle me-2"></i>Предупреждения
                </a>
                <a href="/dashboard?tab=automod" class="nav-link <%= activeTab === 'moderation/automod' ? 'active' : '' %> text-start">
                    <i class="bi bi-robot me-2"></i>Автомодерация
                </a>
            </div>

            <div class="text-muted small fw-bold px-2 mb-2 text-uppercase">Защита</div>
            <div class="nav flex-column nav-pills gap-1 mb-4">
                <a href="/dashboard?tab=security" class="nav-link <%= activeTab === 'security/restrictions' ? 'active' : '' %> text-start">
                    <i class="bi bi-shield-shaded me-2"></i>Ограничения
                </a>
                <a href="/dashboard?tab=securityWhitelist" class="nav-link <%= activeTab === 'security/whitelist' ? 'active' : '' %> text-start">
                    <i class="bi bi-check-circle me-2"></i>Белый список
                </a>
                <a href="/dashboard?tab=securityLogs" class="nav-link <%= activeTab === 'security/logs' ? 'active' : '' %> text-start">
                    <i class="bi bi-clock-history me-2"></i>Логи защиты
                </a>
                <a href="/dashboard?tab=securitySettings" class="nav-link <%= activeTab === 'security/settings' ? 'active' : '' %> text-start">
                    <i class="bi bi-gear me-2"></i>Настройки
                </a>
                <a href="/dashboard?tab=securityBackups" class="nav-link <%= activeTab === 'security/backups' ? 'active' : '' %> text-start">
                    <i class="bi bi-database me-2"></i>Резервные копии
                </a>
            </div>
        </div>

        <div class="p-2 border-top border-secondary-subtle pt-3">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <img src="<%= currentUser.avatar %>" class="rounded-circle" width="32">
                    <span class="fw-semibold text-white"><%= currentUser.username %></span>
                </div>
                <% if (isOwner) { %>
                    <a href="/dashboard?tab=settings" class="btn btn-sm btn-outline-light border-0 p-1" title="Настройки сайта" style="line-height: 1;">
                        <i class="bi bi-gear-fill <%= activeTab === 'ownerSettings' ? 'text-accent' : 'text-muted' %>" style="font-size: 1.1rem;"></i>
                    </a>
                <% } %>
            </div>
            <form method="POST" action="/logout" class="m-0">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">Выйти</button>
            </form>
        </div>
    </div>

    <!-- Main Content Zone -->
    <div class="flex-grow-1 p-4 bg-transparent">
        <div class="tab-content" id="v-pills-tabContent">
            <% if (activeTab === 'tickets/panels') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/panels') %>
                </div>
            <% } %>

            <% if (activeTab === 'tickets/list') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/list') %>
                </div>
            <% } %>

            <% if (activeTab === 'tickets/logs') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/logs') %>
                </div>
            <% } %>

            <% if (activeTab === 'tickets/stats') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/stats') %>
                </div>
            <% } %>

            <% if (activeTab === 'tickets/forms') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/forms') %>
                </div>
            <% } %>

            <% if (activeTab === 'tickets/editForm') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/editForm') %>
                </div>
            <% } %>

            <% if (activeTab === 'tickets/applications') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/tickets/applications') %>
                </div>
            <% } %>

            <% if (activeTab === 'embed') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/embedBuilder') %>
                </div>
            <% } %>

            <% if (activeTab === 'notifications/polls') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/notifications/polls') %>
                </div>
            <% } %>

            <% if (activeTab === 'notifications/reactionRoles') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/notifications/reactionRoles') %>
                </div>
            <% } %>

            <% if (activeTab === 'notifications/levels') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/notifications/levels') %>
                </div>
            <% } %>

            <% if (activeTab === 'notifications/sounds') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/notifications/sounds') %>
                </div>
            <% } %>

            <% if (activeTab === 'ownerSettings' && isOwner) { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/ownerSettings') %>
                </div>
            <% } %>

            <% if (activeTab === 'moderation/logs') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/moderation/logs') %>
                </div>
            <% } %>

            <% if (activeTab === 'moderation/settings') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/moderation/settings') %>
                </div>
            <% } %>

            <% if (activeTab === 'moderation/warnings') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/moderation/warnings') %>
                </div>
            <% } %>

            <% if (activeTab === 'moderation/automod') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/moderation/automod') %>
                </div>
            <% } %>

            <% if (activeTab === 'analytics/member') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/analytics/memberProfile') %>
                </div>
            <% } %>

            <% if (activeTab === 'analytics/weeklyReport') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/analytics/weeklyReport') %>
                </div>
            <% } %>

            <% if (activeTab === 'analytics/swearWords') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/analytics/swearWords') %>
                </div>
            <% } %>

            <% if (activeTab === 'security/restrictions') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/security/restrictions') %>
                </div>
            <% } %>

            <% if (activeTab === 'security/whitelist') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/security/whitelist') %>
                </div>
            <% } %>

            <% if (activeTab === 'security/logs') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/security/logs') %>
                </div>
            <% } %>

            <% if (activeTab === 'security/settings') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/security/settings') %>
                </div>
            <% } %>

            <% if (activeTab === 'security/backups') { %>
                <div class="tab-pane fade show active" role="tabpanel">
                    <%- include('partials/security/backups') %>
                </div>
            <% } %>

            <% if (activeTab === 'ownerClan' && isOwner) { %>
                <div class="tab-pane fade show active" role="tabpanel"><%- include('partials/clanSettings') %></div>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/dashboard.js"></script>
<script src="/js/formsManager.js"></script>
</body>
</html>
