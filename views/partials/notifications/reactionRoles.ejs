<style>
    .rr-card {
        background: #181920;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 20px;
    }
    .rr-card .form-control, .rr-card .form-select {
        background: #121318 !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
    }
    .rr-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
    .rr-tab {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #d1d5db;
        border-radius: 10px;
        padding: 8px 16px;
        font-weight: 600;
        cursor: pointer;
    }
    .rr-tab.active {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: #fff;
    }
    .rr-pane { display: none; }
    .rr-pane.active { display: block; }

    /* Предпросмотр эмбед в стиле Discord */
    .rr-discord { background: #313338; border-radius: 8px; padding: 16px; color: #dbdee1; }
    .rr-embed {
        background: #2b2d31;
        border-left: 4px solid var(--accent-color);
        border-radius: 8px;
        padding: 16px;
        max-width: 500px;
    }
    .rr-embed-title { font-weight: 700; color: #fff; font-size: 1.1rem; margin-bottom: 8px; }
    .rr-embed-desc { color: #dbdee1; font-size: 0.95rem; line-height: 1.4; word-break: break-word; }
    .rr-embed-image { width: 100%; border-radius: 8px; margin-bottom: 12px; display: none; }
    .rr-embed-fields { margin-top: 12px; }
    .rr-embed-field { margin-bottom: 8px; }
    .rr-embed-field-name { font-weight: 600; color: #fff; font-size: 0.9rem; margin-bottom: 4px; }
    .rr-embed-field-value { color: #dbdee1; font-size: 0.9rem; line-height: 1.3; }

    /* Список маппингов */
    .rr-mapping-item {
        background: #1e1f22;
        border: 1px solid #3f4147;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .rr-mapping-emoji { font-size: 1.5rem; min-width: 30px; text-align: center; }
    .rr-mapping-info { flex: 1; }
    .rr-mapping-label { color: #fff; font-weight: 600; font-size: 0.9rem; }
    .rr-mapping-role { color: #949ba4; font-size: 0.85rem; }
    .rr-mapping-delete {
        background: #da373c;
        border: none;
        color: #fff;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        font-size: 0.85rem;
    }
    .rr-mapping-delete:hover { background: #a1282c; }
    .rr-mapping-actions { display: flex; gap: 6px; }
    .rr-mapping-edit {
        background: #4e5058;
        border: none;
        color: #fff;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        font-size: 0.85rem;
    }
    .rr-mapping-edit:hover { background: #6d6f78; }

    /* Список авторолей */
    .rr-list-item {
        background: #1e1f22;
        border: 1px solid #3f4147;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .rr-list-color {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        flex-shrink: 0;
    }
    .rr-list-info { flex: 1; }
    .rr-list-title { color: #fff; font-weight: 600; font-size: 1rem; margin-bottom: 4px; }
    .rr-list-desc { color: #949ba4; font-size: 0.85rem; }
    .rr-list-meta { color: #5865f2; font-size: 0.8rem; margin-top: 4px; }
    .rr-list-actions { display: flex; gap: 8px; }
    .rr-btn {
        background: #4e5058;
        border: none;
        color: #fff;
        border-radius: 6px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 0.85rem;
    }
    .rr-btn:hover { background: #6d6f78; }
    .rr-btn-primary { background: var(--accent-color); }
    .rr-btn-primary:hover { opacity: 0.9; }
    .rr-btn-danger { background: #da373c; }
    .rr-btn-danger:hover { background: #a1282c; }
</style>

<div class="container-fluid py-4" id="reactionRolesPage" data-guild-id="<%= guildId %>">
    <div class="mb-4">
        <h3 class="fw-bold text-white mb-1"><i class="bi bi-emoji-smile text-accent me-2"></i>Автороли</h3>
        <p class="text-muted small mb-0">Создавайте эмбед сообщения с ролями, которые участники могут получить через реакции</p>
    </div>

    <div class="rr-tabs">
        <div class="rr-tab active" data-tab="list">📋 Список авторолей</div>
        <div class="rr-tab" data-tab="create">➕ Создать автороль</div>
    </div>

    <!-- Вкладка со списком авторолей -->
    <div class="rr-pane active" id="rr-pane-list">
        <div class="rr-card">
            <div id="rr-list-container">
                <div class="text-center text-muted py-4">Загрузка авторолей...</div>
            </div>
        </div>
    </div>

    <!-- Вкладка создания/редактирования автороли -->
    <div class="rr-pane" id="rr-pane-create">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="rr-card">
                    <h5 class="text-white mb-3">Основные настройки</h5>
                    
                    <label class="form-label text-muted small">Заголовок эмбеда</label>
                    <input type="text" id="rr-title" class="form-control mb-3" placeholder="Название автороли" maxlength="255">
                    
                    <label class="form-label text-muted small">Описание</label>
                    <textarea id="rr-description" class="form-control mb-3" rows="3" placeholder="Описание автороли..."></textarea>
                    
                    <label class="form-label text-muted small">Цвет эмбеда</label>
                    <input type="color" id="rr-color" class="form-control form-control-color mb-3" value="#5865F2" style="height: 40px;">
                    
                    <label class="form-label text-muted small">Изображение (опционально)</label>
                    <input type="file" id="rr-image" class="form-control mb-3" accept="image/*">
                    <button type="button" class="btn btn-sm btn-outline-danger mb-3" id="rr-remove-image" style="display:none;">
                        <i class="bi bi-trash me-1"></i>Удалить изображение
                    </button>
                    
                    <button type="button" class="btn btn-accent text-white" id="rr-save-basic">
                        <i class="bi bi-save me-1"></i>Сохранить
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-2" id="rr-reset">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Сбросить
                    </button>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="rr-card">
                    <h5 class="text-white mb-3">Предпросмотр</h5>
                    <div class="rr-discord">
                        <div class="rr-embed" id="rr-preview">
                            <img src="" alt="" class="rr-embed-image" id="rr-preview-image">
                            <div class="rr-embed-title" id="rr-preview-title">Заголовок автороли</div>
                            <div class="rr-embed-desc" id="rr-preview-desc">Описание автороли</div>
                            <div class="rr-embed-fields" id="rr-preview-fields"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="rr-card">
                    <h5 class="text-white mb-3">Маппинги эмодзи → роли</h5>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <input type="text" id="rr-emoji" class="form-control" placeholder="Эмодзи 😊" maxlength="50">
                        </div>
                        <div class="col-md-4">
                            <select id="rr-role" class="form-select">
                                <option value="">Выберите роль</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="text" id="rr-label" class="form-control" placeholder="Название роли" maxlength="100">
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-success w-100" id="rr-add-mapping">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div id="rr-mappings-list">
                        <div class="text-center text-muted py-3">Нет добавленных маппингов</div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="rr-card">
                    <h5 class="text-white mb-3">Публикация в Discord</h5>
                    
                    <label class="form-label text-muted small">Канал для отправки</label>
                    <select id="rr-channel" class="form-select mb-3">
                        <option value="">Выберите канал</option>
                    </select>
                    
                    <button type="button" class="btn btn-primary" id="rr-publish">
                        <i class="bi bi-send me-1"></i>Отправить в Discord
                    </button>
                    <div id="rr-publish-status" class="text-success small mt-2" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/reactionRoles.js"></script>