<div class="glass-card p-4" id="announcementsPage" data-guild-id="<%= guildId %>">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-megaphone-fill text-accent fs-4"></i>
            <h4 class="fw-bold mb-0 text-white">Конструктор объявлений</h4>
        </div>
    </div>

    <div id="announceStatus" class="alert py-2 small mb-3" style="display: none;"></div>

    <div class="row g-4">
        <!-- Левая колонка: Настройки -->
        <div class="col-lg-6">
            <!-- Загрузить сохраненный шаблон -->
            <div class="mb-3">
                <label class="form-label d-flex align-items-center gap-2">
                    <i class="bi bi-folder-fill text-warning"></i> Загрузить сохранённый шаблон
                </label>
                <div class="d-flex gap-2">
                    <select class="form-select form-control-dark" id="templateSelect">
                        <option value="" selected>-- Выберите шаблон --</option>
                    </select>
                    <button class="btn btn-outline-danger" id="deleteTemplateBtn" title="Удалить шаблон">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="channelId">Канал</label>
                    <select class="form-select form-control-dark" id="channelId">
                        <option value="">-- Выберите канал --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="messageId">ID сообщения (для ред.)</label>
                    <input type="text" class="form-control form-control-dark" id="messageId" placeholder="Заполнится после отправки">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="pingRole">Упомянуть при отправке</label>
                <select class="form-select form-control-dark" id="pingRole">
                    <option value="">Не упоминать</option>
                    <option value="everyone">@everyone</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="embedTitle">Заголовок</label>
                <input type="text" class="form-control form-control-dark" id="embedTitle" maxlength="256" placeholder="Заголовок объявления">
            </div>

            <div class="mb-3">
                <label class="form-label" for="embedDescription">Основной текст</label>
                <textarea class="form-control form-control-dark" id="embedDescription" rows="4" maxlength="4096" placeholder="Текст сообщения..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="embedColor">Цвет полосы</label>
                <input type="color" class="form-control form-control-color w-100 form-control-dark p-1" id="embedColor" value="#8b5cf6" style="height: 38px;">
            </div>

            <div class="mb-3">
                <label class="form-label" for="embedAuthor">Автор</label>
                <input type="text" class="form-control form-control-dark" id="embedAuthor" maxlength="256" placeholder="Имя автора">
            </div>

            <div class="mb-3">
                <label class="form-label d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-image text-info"></i> Фото с устройства
                </label>
                <input class="form-control form-control-dark" type="file" id="imageFileUpload" accept="image/png,image/jpeg,image/gif,image/webp">
                <div class="form-text text-muted">До 8 МБ. При редактировании сообщения картинку нужно указать заново.</div>
            </div>

            <div class="mb-3">
                <label class="form-label d-flex align-items-center gap-2">
                    <i class="bi bi-link-45deg"></i> Или URL картинки
                </label>
                <input type="text" class="form-control form-control-dark" id="imageUrl" placeholder="https://i.imgur.com/example.png">
            </div>

            <!-- Блок отправки по таймеру -->
            <div class="mb-4">
                <label class="form-label d-flex align-items-center gap-2">
                    <i class="bi bi-alarm-fill text-danger"></i> Отправка по таймеру
                </label>
                <input type="datetime-local" class="form-control form-control-dark" id="scheduleTime">
                <div class="form-text text-muted">Время в вашем часовом поясе. Работает, даже если бот перезапустится.</div>
            </div>

            <!-- Панель кнопок управления -->
            <div class="row g-2">
                <div class="col-6">
                    <button class="btn btn-accent w-100 py-2 d-flex align-items-center justify-content-center gap-2" id="sendEmbedBtn">
                        <i class="bi bi-rocket-takeoff-fill"></i> Отправить
                    </button>
                </div>
                <div class="col-6">
                    <button class="btn btn-warning w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" id="editEmbedBtn">
                        <i class="bi bi-pencil-fill"></i> Отредактировать
                    </button>
                </div>
                <div class="col-6">
                    <button class="btn btn-outline-info w-100 py-2 d-flex align-items-center justify-content-center gap-2" id="saveTemplateBtn">
                        <i class="bi bi-floppy-fill"></i> Сохранить шаблон
                    </button>
                </div>
                <div class="col-6">
                    <button class="btn btn-outline-light w-100 py-2 d-flex align-items-center justify-content-center gap-2" id="scheduleEmbedBtn">
                        <i class="bi bi-alarm-fill"></i> Запланировать
                    </button>
                </div>
            </div>
        </div>

        <!-- Правая колонка: Живой Предпросмотр Discord -->
        <div class="col-lg-6">
            <label class="form-label mb-2 d-flex align-items-center gap-2">
                <i class="bi bi-eye-fill text-accent"></i> Предпросмотр в Discord
            </label>

            <div class="discord-preview-container p-3 rounded-3">
                <div class="d-flex align-items-start gap-3">
                    <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="rounded-circle" width="40" height="40" alt="Bot Avatar">
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fw-bold text-white small">Ticket Bot</span>
                            <span class="badge bg-primary text-white" style="font-size: 0.65rem; padding: 2px 4px;">БОТ</span>
                            <span class="text-muted small" style="font-size: 0.75rem;">Сегодня, в 12:00</span>
                        </div>

                        <!-- Сам Discord Embed -->
                        <div class="discord-embed position-relative p-3 rounded-1 mt-2" id="previewEmbed" style="border-left: 4px solid #8b5cf6; background: #2b2d31;">
                            <div class="discord-embed-author text-white fw-semibold small mb-1 opacity-75" id="previewAuthor" style="display: none;"></div>
                            <div class="discord-embed-title text-white fw-bold mb-2 fs-6" id="previewTitle">Заголовок объявления</div>
                            <div class="discord-embed-description text-light small mb-2" id="previewDescription" style="white-space: pre-wrap; color: #dbdee1 !important;">Текст сообщения...</div>
                            <div class="discord-embed-image mt-2" id="previewImageWrapper" style="display: none;">
                                <img src="" id="previewImage" class="img-fluid rounded" style="max-height: 260px; object-fit: cover;" alt="Embed Image">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Запланированные объявления -->
            <div class="mt-4">
                <label class="form-label mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-event text-accent"></i> Запланированные объявления
                </label>
                <div id="scheduledList" class="d-flex flex-column gap-2">
                    <div class="text-muted small">Загрузка...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/announcements.js"></script>