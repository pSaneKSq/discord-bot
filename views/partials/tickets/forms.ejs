<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-ui-checks-grid text-accent me-2"></i> Управление формами</h3>
            <p class="text-muted small mb-0">Создавайте, настраивайте и публикуйте интерактивные формы в Discord</p>
        </div>
        <button class="btn text-white fw-semibold px-4 shadow" id="createNewFormBtn" style="background-color: #8b5cf6 !important; border: none;">
            <i class="bi bi-plus-lg me-1"></i> Создать форму
        </button>
    </div>

    <!-- Контейнер со списком форм -->
    <div class="row g-4" id="formsContainer">
        <% if (typeof cards !== 'undefined' && cards.length > 0) { %>
            <% cards.forEach(card => { %>
                <div class="col-xl-4 col-md-6 form-card-wrapper" data-form-id="<%= card.id %>">
                    <div class="glass-card p-4 h-d-flex flex-column justify-content-between rounded-4" style="background: #181920; border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text text-accent"></i> <%= card.title %>
                                </h5>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 px-2 py-1">
                                    <i class="bi bi-circle-fill" style="font-size: 6px;"></i> Опубликовано
                                </span>
                            </div>
                            
                            <div class="mb-3 small">
                                <span class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Канал для проверки</span>
                                <span class="text-light font-monospace"><%= card.channelId ? `<#${card.channelId}>` : 'Канал не выбран' %></span>
                            </div>

                            <div class="row g-2 mb-4">
                                <div class="col-6">
                                    <div class="p-2 rounded-3" style="background: rgba(255, 255, 255, 0.03);">
                                        <span class="text-muted d-block" style="font-size: 0.7rem;">Вопросов</span>
                                        <span class="text-white fw-semibold small"><%= card.questionsCount || 1 %> Вопрос</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 rounded-3" style="background: rgba(255, 255, 255, 0.03);">
                                        <span class="text-muted d-block" style="font-size: 0.7rem;">ID сообщения</span>
                                        <span class="text-white fw-semibold small font-monospace text-truncate d-inline-block w-100"><%= card.messageId || 'Нет' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 pt-2 border-top border-secondary border-opacity-10">
                            <button class="btn btn-sm text-white fw-semibold publish-form-btn flex-grow-1" style="background: #5865F2; border: none;">
                                <i class="bi bi-send-fill me-1"></i> Опубликовать
                            </button>
                            <a href="/forms/<%= card.id %>/edit" class="btn btn-sm text-light text-decoration-none px-3" style="background: rgba(255, 255, 255, 0.08);">
                                <i class="bi bi-pencil-fill me-1"></i> Редактировать
                            </a>
                            <button class="btn btn-sm btn-outline-danger px-2 delete-form-btn" title="Удалить">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <p class="text-muted">Пока нет созданных форм. Нажмите «Создать форму», чтобы начать.</p>
            </div>
        <% } %>
    </div>
</div>