<style>
    /* Все стили страницы «Статистика» имеют префикс st- и цвета от --accent-color */
    .st-muted { color: #9ca3af !important; font-weight: 500; }
    .st-card {
        background: var(--glass-bg); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;
        padding: 14px 16px; height: 100%; min-height: 128px; display: flex; flex-direction: column;
        justify-content: space-between; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    }
    .st-card-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .st-value { font-size: 1.7rem; font-weight: 700; line-height: 1.15; color: #fff !important; min-width: 48px; }
    .st-value-sm { font-size: 1.3rem; }
    .st-sub { font-size: 0.75rem; }
    .st-spark { height: 34px; position: relative; }
    .st-trend { font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; color: #9ca3af !important; background: rgba(255,255,255,0.06); }
    .st-trend.up { color: #22c55e !important; background: rgba(34,197,94,0.12); }
    .st-trend.down { color: #ef4444 !important; background: rgba(239,68,68,0.12); }

    .st-tabs .nav-link { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); font-size: 0.88rem; font-weight: 600; padding: 9px 15px; }

    .st-panel-title { color: #fff !important; font-weight: 700; margin: 0; }
    .st-chart-wrap { position: relative; }
    .st-empty {
        position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        color: #9ca3af; font-size: 0.85rem; text-align: center; pointer-events: none;
    }

    .st-chips { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .st-chip { background: rgba(255,255,255,0.05); border-radius: 10px; padding: 8px 14px; min-width: 110px; }
    .st-chip b { display: block; color: #fff; font-size: 1.05rem; }

    .st-seg { display: inline-flex; background: rgba(255,255,255,0.05); border-radius: 10px; padding: 3px; }
    .st-seg button {
        border: 0; background: transparent; color: #9ca3af; font-size: 0.8rem; font-weight: 600;
        padding: 4px 12px; border-radius: 8px;
    }
    .st-seg button.active { background: var(--accent-color); color: #fff; }

    .st-top-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .st-top-row:last-child { border-bottom: none; }
    .st-rank { width: 20px; text-align: center; font-size: 0.8rem; font-weight: 700; color: #9ca3af; flex-shrink: 0; }
    .st-top-row:nth-child(1) .st-rank { color: #fbbf24; }
    .st-top-row:nth-child(2) .st-rank { color: #d1d5db; }
    .st-top-row:nth-child(3) .st-rank { color: #d18a4f; }
    .st-ava { width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; }
    .st-name { color: #fff; font-size: 0.85rem; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .st-track { background: rgba(255,255,255,0.06); border-radius: 6px; height: 6px; flex-grow: 1; overflow: hidden; }
    .st-fill { height: 100%; background: var(--accent-color); border-radius: 6px; }
    .st-num { font-size: 0.78rem; color: #9ca3af; flex-shrink: 0; }

    .st-heat-grid { display: grid; grid-template-columns: 34px repeat(24, 1fr); gap: 3px; margin-bottom: 3px; }
    .st-heat-cell { aspect-ratio: 1; border-radius: 3px; min-width: 0; }
    .st-heat-label { font-size: 0.68rem; color: #9ca3af; display: flex; align-items: center; }
    .st-heat-hour { font-size: 0.6rem; color: #6b7280; text-align: center; }
    .st-heat-scroll { overflow-x: auto; }
    .st-heat-inner { min-width: 620px; }

    /* Скелетон при загрузке */
    .st-loading .st-value, .st-loading .st-top-skel {
        color: transparent !important; border-radius: 6px;
        background: linear-gradient(90deg, rgba(255,255,255,0.06), rgba(255,255,255,0.15), rgba(255,255,255,0.06));
        background-size: 200% 100%; animation: stShimmer 1.2s linear infinite;
    }
    @keyframes stShimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    @media (prefers-reduced-motion: reduce) { .st-loading .st-value { animation: none; } }
</style>

<div class="container-fluid py-4" id="analyticsPage" data-guild-id="<%= guildId %>">

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-graph-up-arrow text-accent me-2"></i>Статистика</h3>
            <p class="st-muted small mb-0">Активность сервера: сообщения, войс, участники и статусы. <span class="st-muted" id="lastUpdated"></span></p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select" id="rangeSelect" style="width:auto;">
                <option value="1">24 часа</option>
                <option value="7" selected>7 дней</option>
                <option value="30">30 дней</option>
                <option value="90">90 дней</option>
            </select>
            <button class="btn btn-outline-light d-flex align-items-center gap-2" id="refreshBtn">
                <i class="bi bi-arrow-clockwise"></i> Обновить
            </button>
        </div>
    </div>

    <!-- КАРТОЧКИ СВОДКИ (одинаковой высоты) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Участников</span><i class="bi bi-people-fill text-accent"></i></div>
                <div class="st-value" id="statTotalMembers">—</div>
                <div class="st-sub st-muted" id="statNet">&nbsp;</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Сообщений</span><span class="st-trend" id="trendMessages"></span></div>
                <div class="st-value" id="statMessages">—</div>
                <div class="st-spark"><canvas id="sparkMessages"></canvas></div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Часов в войсе</span><span class="st-trend" id="trendVoice"></span></div>
                <div class="st-value" id="statVoice">—</div>
                <div class="st-spark"><canvas id="sparkVoice"></canvas></div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Активных</span><span class="st-trend" id="trendActive"></span></div>
                <div class="st-value" id="statActive">—</div>
                <div class="st-sub st-muted">писали или сидели в войсе</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Пришло / Ушло</span><i class="bi bi-arrow-left-right text-warning"></i></div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="st-value text-success" id="statJoins" style="color:#22c55e !important;">—</span>
                    <span class="st-muted">/</span>
                    <span class="st-value" id="statLeaves" style="color:#ef4444 !important;">—</span>
                </div>
                <div class="st-sub st-muted">за выбранный период</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Пик активности</span><i class="bi bi-fire text-danger"></i></div>
                <div class="st-value st-value-sm" id="statPeak">—</div>
                <div class="st-sub st-muted text-truncate" id="statTopChannel">&nbsp;</div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="st-card">
                <div class="st-card-head"><span class="st-muted small">Матов</span><span class="st-trend" id="trendSwears"></span></div>
                <div class="st-value" id="statSwears">—</div>
                <div class="st-spark"><canvas id="sparkSwears"></canvas></div>
            </div>
        </div>
    </div>

    <!-- ВКЛАДКИ -->
    <ul class="nav nav-pills st-tabs gap-2 mb-4" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pane-overview" type="button"><i class="bi bi-grid-1x2-fill me-1"></i>Обзор</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-messages" type="button"><i class="bi bi-chat-dots-fill me-1"></i>Сообщения</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-voice" type="button"><i class="bi bi-mic-fill me-1"></i>Войс</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-members" type="button"><i class="bi bi-people-fill me-1"></i>Участники</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-swears" type="button"><i class="bi bi-exclamation-triangle-fill me-1"></i>Маты</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-heatmap" type="button"><i class="bi bi-fire me-1"></i>Активность</button></li>
    </ul>

    <div class="tab-content">

        <!-- ОБЗОР -->
        <div class="tab-pane fade show active" id="pane-overview">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Сообщения по дням</h6>
                        <div class="st-chart-wrap"><canvas id="chartOverviewMessages" height="180"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Часы в войсе по дням</h6>
                        <div class="st-chart-wrap"><canvas id="chartOverviewVoice" height="180"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Пришло / Ушло участников</h6>
                        <div class="st-chart-wrap"><canvas id="chartOverviewMembers" height="130"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="glass-card p-4 h-100">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="st-panel-title">Топ-5 участников</h6>
                            <div class="st-seg" id="topModeSwitch">
                                <button type="button" class="active" data-top-mode="messages">Сообщения</button>
                                <button type="button" data-top-mode="voice">Войс</button>
                            </div>
                        </div>
                        <div id="topOverview"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- СООБЩЕНИЯ -->
        <div class="tab-pane fade" id="pane-messages">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <h6 class="st-panel-title">Динамика сообщений</h6>
                            <div class="d-flex align-items-center gap-2">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="messagesMovingAvgToggle" checked>
                                    <label class="form-check-label st-muted small" for="messagesMovingAvgToggle">Скользящее среднее</label>
                                </div>
                                <button class="btn btn-sm btn-outline-light" data-export="messages"><i class="bi bi-download me-1"></i>CSV</button>
                            </div>
                        </div>
                        <div class="st-chips">
                            <div class="st-chip"><span class="st-muted small">Всего</span><b id="msgTotal">—</b></div>
                            <div class="st-chip"><span class="st-muted small">В среднем в день</span><b id="msgAvg">—</b></div>
                            <div class="st-chip"><span class="st-muted small">Лучший день</span><b id="msgBest">—</b></div>
                        </div>
                        <div class="st-chart-wrap"><canvas id="chartMessages" height="140"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="glass-card p-4 mb-3">
                        <h6 class="st-panel-title mb-3">Топ участников</h6>
                        <div id="topMembersMessages"></div>
                    </div>
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Топ каналов</h6>
                        <div id="topChannelsMessages"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ВОЙС -->
        <div class="tab-pane fade" id="pane-voice">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="st-panel-title">Динамика войса (часы)</h6>
                            <button class="btn btn-sm btn-outline-light" data-export="voice"><i class="bi bi-download me-1"></i>CSV</button>
                        </div>
                        <div class="st-chips">
                            <div class="st-chip"><span class="st-muted small">Всего, ч</span><b id="voiceTotal">—</b></div>
                            <div class="st-chip"><span class="st-muted small">В среднем в день, ч</span><b id="voiceAvg">—</b></div>
                            <div class="st-chip"><span class="st-muted small">Лучший день</span><b id="voiceBest">—</b></div>
                        </div>
                        <div class="st-chart-wrap"><canvas id="chartVoice" height="140"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="glass-card p-4 mb-3">
                        <h6 class="st-panel-title mb-3">Топ по войсу</h6>
                        <div id="topMembersVoice"></div>
                    </div>
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Топ голосовых каналов</h6>
                        <div id="topChannelsVoice"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- УЧАСТНИКИ -->
        <div class="tab-pane fade" id="pane-members">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="st-panel-title">Чистый прирост (пришло минус ушло)</h6>
                            <button class="btn btn-sm btn-outline-light" data-export="members"><i class="bi bi-download me-1"></i>CSV</button>
                        </div>
                        <div class="st-chart-wrap"><canvas id="chartNet" height="150"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Статусы участников</h6>
                        <div class="st-chart-wrap"><canvas id="chartStatus" height="150"></canvas></div>
                        <p class="st-muted small mt-2 mb-0">Замеры делаются раз в 15 минут и хранятся 30 дней.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- МАТЫ -->
        <div class="tab-pane fade" id="pane-swears">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="st-panel-title">Динамика матов</h6>
                            <button class="btn btn-sm btn-outline-light" data-export="swears"><i class="bi bi-download me-1"></i>CSV</button>
                        </div>
                        <div class="st-chips">
                            <div class="st-chip"><span class="st-muted small">Всего</span><b id="swearTotal">—</b></div>
                            <div class="st-chip"><span class="st-muted small">В среднем в день</span><b id="swearAvg">—</b></div>
                            <div class="st-chip"><span class="st-muted small">Лучший день</span><b id="swearBest">—</b></div>
                        </div>
                        <div class="st-chart-wrap"><canvas id="chartSwears" height="140"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="glass-card p-4">
                        <h6 class="st-panel-title mb-3">Топ матерящихся</h6>
                        <div id="topSwearers"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ТЕПЛОВАЯ КАРТА -->
        <div class="tab-pane fade" id="pane-heatmap">
            <div class="glass-card p-4">
                <h6 class="st-panel-title mb-1">Тепловая карта активности</h6>
                <p class="st-muted small mb-3">Когда сервер оживает: по дням недели и часам (UTC). Период не короче 7 дней.</p>
                <div class="st-heat-scroll"><div class="st-heat-inner" id="heatmapContainer"></div></div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/js/analyticsPage.js"></script>
