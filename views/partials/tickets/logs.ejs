<style>
    .log-row {
        background: #181920;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 16px 20px;
        transition: border-color 0.15s ease;
    }
    .log-row:hover { border-color: rgba(139,92,246,0.35); }
    .log-avatar { width: 36px; height: 36px; }
</style>

