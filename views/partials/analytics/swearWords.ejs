<style>
    .sw-card {
        background: #181920;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 20px;
    }
    .sw-card .form-control, .sw-card .form-select {
        background: #121318 !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
    }
    .sw-word-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 8px;
        margin-bottom: 8px;
    }
    .sw-word-item:last-child {
        margin-bottom: 0;
    }
    .sw-word-text {
        font-family: monospace;
        font-size: 0.95rem;
        color: #f87171;
    }
    .sw-empty {
        text-align: center;
        padding: 40px 20px;
        color: #9ca3af;
    }
</style>

<div class="container-fluid py-4" id="swearWordsPage" data-guild-id="<%= guildId %>">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-exclamation-triangle text-accent me-2"></i>Список матов</h3>
            <p class="text-muted small mb-0">Управляйте списком слов, которые бот считает за маты. Эти слова будут отслеживаться в статистике.</p>
        </div>
    </div>

    <div id="swAlert" class="alert py-2 small mb-3" style="display:none;"></div>

    <div class="row g-4">
        <!-- Левая колонка: добавление слов -->
        <div class="col-lg-5">
            <div class="sw-card">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-plus-circle me-2"></i>Добавить слово</h5>
                <div class="mb-3">
                    <label class="form-label text-muted small">Слово (без учёта регистра)</label>
                    <input type="text" class="form-control" id="swWordInput" placeholder="Например: блин" maxlength="100">
                </div>
                <button class="btn btn-accent text-white fw-semibold" id="swAddBtn">
                    <i class="bi bi-plus-lg me-1"></i>Добавить
                </button>
                <div class="text-muted small mt-2">
                    Бот будет искать это слово в сообщениях и записывать статистику.
                    Поиск нечувствителен к регистру.
                </div>
            </div>
        </div>

        <!-- Правая колонка: список слов -->
        <div class="col-lg-7">
            <div class="sw-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-white mb-0"><i class="bi bi-list-ul me-2"></i>Текущий список</h5>
                    <span class="badge bg-secondary" id="swCount">0 слов</span>
                </div>
                <div id="swWordsList">
                    <div class="sw-empty">Загрузка...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/swearWords.js"></script>
