<div class="security-tab">
    <div class="tab-header">
        <h2>🛡️ Белый список</h2>
        <p class="text-muted">Пользователи, на которых не действуют ограничения</p>
    </div>

    <div class="add-whitelist-section">
        <h4>Добавить в белый список</h4>
        <div class="add-whitelist-form">
            <input type="text" id="whitelistUserId" placeholder="Discord ID пользователя" class="form-control">
            <input type="text" id="whitelistUserName" placeholder="Имя пользователя (опционально)" class="form-control">
            <label class="permanent-toggle">
                <input type="checkbox" id="whitelistPermanent" checked>
                <span>Постоянный</span>
            </label>
            <button id="addToWhitelistBtn" class="btn btn-success">➕ Добавить</button>
        </div>
    </div>

    <div class="whitelist-list">
        <h4>Белый список</h4>
        <div id="whitelistContent" class="whitelist-content">
            <p class="text-muted">Загрузка...</p>
        </div>
    </div>
</div>

<style>
.security-tab {
    padding: 20px;
}

.tab-header {
    margin-bottom: 30px;
}

.tab-header h2 {
    margin: 0 0 10px 0;
    color: #ffffff;
}

.text-muted {
    color: #99aab5;
}

.add-whitelist-section {
    background: #2f3136;
    border: 1px solid #40444b;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 30px;
}

.add-whitelist-section h4 {
    margin: 0 0 15px 0;
    color: #ffffff;
}

.add-whitelist-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}

.form-control {
    flex: 1;
    min-width: 200px;
    padding: 10px 15px;
    border: 1px solid #40444b;
    border-radius: 4px;
    background: #393c43;
    color: #ffffff;
    font-size: 14px;
}

.form-control:focus {
    outline: none;
    border-color: #5865f2;
}

.permanent-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: 14px;
    cursor: pointer;
}

.permanent-toggle input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
}

.btn-success {
    background: #3ba55c;
    color: #ffffff;
}

.btn-success:hover {
    background: #2d7d46;
}

.btn-danger {
    background: #ed4245;
    color: #ffffff;
}

.btn-danger:hover {
    background: #c93b3e;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 12px;
}

.whitelist-list h4 {
    margin: 0 0 15px 0;
    color: #ffffff;
}

.whitelist-content {
    max-height: 500px;
    overflow-y: auto;
}

.whitelist-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    background: #2f3136;
    border: 1px solid #40444b;
    border-radius: 6px;
    margin-bottom: 10px;
}

.whitelist-item img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
}

.whitelist-info {
    flex: 1;
}

.whitelist-info h5 {
    margin: 0 0 6px 0;
    color: #ffffff;
    font-size: 16px;
}

.whitelist-info p {
    margin: 3px 0;
    color: #99aab5;
    font-size: 13px;
}

.whitelist-badges {
    display: flex;
    gap: 8px;
    margin-top: 8px;
}

.badge {
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
}

.badge.permanent {
    background: #3ba55c;
    color: #ffffff;
}

.badge.system {
    background: #5865f2;
    color: #ffffff;
}

.whitelist-actions {
    display: flex;
    gap: 8px;
}
</style>

<script>
// Добавить в белый список
document.getElementById('addToWhitelistBtn').addEventListener('click', async () => {
    const userId = document.getElementById('whitelistUserId').value.trim();
    const userName = document.getElementById('whitelistUserName').value.trim();
    const isPermanent = document.getElementById('whitelistPermanent').checked;

    if (!userId) {
        alert('Введите Discord ID пользователя');
        return;
    }

    try {
        const response = await fetch('/api/security/whitelist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, userName, isPermanent })
        });

        if (response.ok) {
            alert('Пользователь добавлен в белый список');
            document.getElementById('whitelistUserId').value = '';
            document.getElementById('whitelistUserName').value = '';
            loadWhitelist();
        } else {
            alert('Ошибка добавления в белый список');
        }
    } catch (error) {
        alert('Ошибка добавления в белый список');
    }
});

// Удалить из белого списка
async function removeFromWhitelist(userId) {
    if (!confirm('Удалить пользователя из белого списка?')) return;

    try {
        const response = await fetch(`/api/security/whitelist/${userId}`, { method: 'DELETE' });
        if (response.ok) {
            loadWhitelist();
        } else {
            alert('Ошибка удаления из белого списка');
        }
    } catch (error) {
        alert('Ошибка удаления из белого списка');
    }
}

// Загрузить белый список
async function loadWhitelist() {
    const contentDiv = document.getElementById('whitelistContent');
    contentDiv.innerHTML = '<p class="text-muted">Загрузка...</p>';

    try {
        const response = await fetch('/api/security/whitelist');
        const whitelist = await response.json();

        if (whitelist.length === 0) {
            contentDiv.innerHTML = '<p class="text-muted">Белый список пуст</p>';
            return;
        }

        contentDiv.innerHTML = whitelist.map(item => `
            <div class="whitelist-item">
                <img src="${item.avatar}" alt="${item.username}">
                <div class="whitelist-info">
                    <h5>${item.username}</h5>
                    <p>ID: ${item.user_id}</p>
                    <div class="whitelist-badges">
                        ${item.is_permanent ? '<span class="badge permanent">Постоянный</span>' : ''}
                        ${item.added_by === 'system' ? '<span class="badge system">Система</span>' : ''}
                    </div>
                </div>
                <div class="whitelist-actions">
                    ${item.added_by !== 'system' ? `
                        <button class="btn btn-sm btn-danger" onclick="removeFromWhitelist('${item.user_id}')">🗑️ Удалить</button>
                    ` : ''}
                </div>
            </div>
        `).join('');
    } catch (error) {
        contentDiv.innerHTML = '<p class="text-muted">Ошибка загрузки белого списка</p>';
    }
}

// Загрузить при инициализации
loadWhitelist();
</script>
