<div class="security-tab">
    <div class="tab-header">
        <h2>🛡️ Ограничения администраторов</h2>
        <p class="text-muted">Настройка ограничений для участников с правами администратора</p>
    </div>

    <div class="search-section">
        <div class="search-box">
            <input type="text" id="userSearch" placeholder="Введите ник или ID участника..." class="form-control">
            <button id="searchUserBtn" class="btn btn-primary">🔍 Найти</button>
        </div>
        <div id="searchResults" class="search-results"></div>
    </div>

    <div id="userProfile" class="user-profile" style="display: none;">
