<script>
const GUILD_ID = '<%= guildId %>';
let currentUserId = null;

// Поиск пользователя
document.getElementById('searchUserBtn').addEventListener('click', async () => {
    const query = document.getElementById('userSearch').value.trim();
    if (!query) return;

    const resultsDiv = document.getElementById('searchResults');
    resultsDiv.innerHTML = '<p class="text-muted">Поиск...</p>';

    try {
        const response = await fetch(`/api/security/search-user?q=${encodeURIComponent(query)}`);
        const users = await response.json();

        if (users.length === 0) {
            resultsDiv.innerHTML = '<p class="text-muted">Пользователи не найдены</p>';
            return;
        }

        resultsDiv.innerHTML = users.map(user => `
            <div class="search-result-item" data-user-id="${user.id}" data-username="${user.username}" data-display-name="${user.displayName}">
                <img src="${user.avatar}" alt="${user.username}">
                <div class="search-result-info">
                    <h4>${user.username}</h4>
                    <p>${user.displayName} • ID: ${user.id}</p>
                </div>
            </div>
        `).join('');

        // Обработка клика на результат
        document.querySelectorAll('.search-result-item').forEach(item => {
            item.addEventListener('click', () => {
                const userId = item.dataset.userId;
                const username = item.dataset.username;
                const displayName = item.dataset.displayName;
                const avatar = item.querySelector('img').src;
                showUserProfile(userId, username, displayName, avatar);
            });
        });
    } catch (error) {
        resultsDiv.innerHTML = '<p class="text-muted">Ошибка поиска</p>';
    }
});

// Показать профиль пользователя
async function showUserProfile(userId, username, displayName, avatar) {
    currentUserId = userId;
    
    document.getElementById('profileAvatar').src = avatar;
    document.getElementById('profileUsername').textContent = username;
    document.getElementById('profileDisplayName').textContent = displayName;
    document.getElementById('profileUserId').textContent = `ID: ${userId}`;
    
    document.getElementById('userProfile').style.display = 'block';
    document.getElementById('searchResults').innerHTML = '';
    document.getElementById('userSearch').value = '';

    // Загрузить существующие ограничения
    try {
        const response = await fetch(`/api/security/restrictions/${userId}`);
        const restrictions = await response.json();

        // Сбросить все чекбоксы
        document.querySelectorAll('.restriction-checkbox').forEach(cb => cb.checked = false);
        document.querySelectorAll('.notification-checkbox').forEach(cb => cb.checked = false);
        document.querySelectorAll('.restriction-method').forEach(select => select.value = 'block');

        // Установить значения из БД
        restrictions.forEach(r => {
            const checkbox = document.querySelector(`.restriction-checkbox[data-type="${r.restriction_type}"]`);
            const method = document.querySelector(`.restriction-method[data-type="${r.restriction_type}"]`);
            const notification = document.querySelector(`.notification-checkbox[data-type="${r.restriction_type}"]`);

            if (checkbox) checkbox.checked = true;
            if (method) method.value = r.restriction_method;
            if (notification) notification.checked = r.notification_enabled;
        });
    } catch (error) {
        console.error('Ошибка загрузки ограничений:', error);
    }
}

// Сохранить ограничения
document.getElementById('saveRestrictions').addEventListener('click', async () => {
    if (!currentUserId) return;

    const restrictions = [];
    document.querySelectorAll('.restriction-checkbox:checked').forEach(checkbox => {
        const type = checkbox.dataset.type;
        const method = document.querySelector(`.restriction-method[data-type="${type}"]`).value;
        const notification = document.querySelector(`.notification-checkbox[data-type="${type}"]`).checked;

        restrictions.push({
            userId: currentUserId,
            userName: document.getElementById('profileUsername').textContent,
            restrictionType: type,
            restrictionMethod: method,
            notificationEnabled: notification
        });
    });

    try {
        // Сначала удалить все ограничения пользователя
        await fetch(`/api/security/restrictions/${currentUserId}`, { method: 'DELETE' });

        // Добавить новые ограничения
        for (const restriction of restrictions) {
            await fetch('/api/security/restrictions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(restriction)
            });
        }

        alert('Ограничения сохранены!');
        loadRestrictionsList();
    } catch (error) {
        alert('Ошибка сохранения ограничений');
    }
});

// Удалить все ограничения
document.getElementById('removeAllRestrictions').addEventListener('click', async () => {
    if (!currentUserId) return;
    if (!confirm('Удалить все ограничения для этого пользователя?')) return;

    try {
        await fetch(`/api/security/restrictions/${currentUserId}`, { method: 'DELETE' });
        alert('Все ограничения удалены!');
        
        // Сбросить UI
        document.querySelectorAll('.restriction-checkbox').forEach(cb => cb.checked = false);
        document.querySelectorAll('.notification-checkbox').forEach(cb => cb.checked = false);
        document.querySelectorAll('.restriction-method').forEach(select => select.value = 'block');
        
        loadRestrictionsList();
    } catch (error) {
        alert('Ошибка удаления ограничений');
    }
});

// Закрыть профиль
document.getElementById('closeProfile').addEventListener('click', () => {
    document.getElementById('userProfile').style.display = 'none';
    currentUserId = null;
});

// Загрузить список ограничений
async function loadRestrictionsList() {
    const listDiv = document.getElementById('restrictionsList');
    listDiv.innerHTML = '<p class="text-muted">Загрузка...</p>';

    try {
        const response = await fetch('/api/security/restrictions');
        const restrictions = await response.json();

        if (restrictions.length === 0) {
            listDiv.innerHTML = '<p class="text-muted">Нет активных ограничений</p>';
            return;
        }

        // Группировка по пользователям
        const grouped = {};
        restrictions.forEach(r => {
            if (!grouped[r.user_id]) {
                grouped[r.user_id] = {
                    user_id: r.user_id,
                    username: r.username,
                    avatar: r.avatar,
                    restrictions: []
                };
            }
            grouped[r.user_id].restrictions.push(r);
        });

        listDiv.innerHTML = Object.values(grouped).map(group => `
            <div class="restriction-card">
                <div class="restriction-card-header">
                    <img src="${group.avatar}" alt="${group.username}">
                    <div class="restriction-card-info">
                        <h5>${group.username}</h5>
                        <p>ID: ${group.user_id}</p>
                    </div>
                </div>
                <div class="restriction-tags">
                    ${group.restrictions.map(r => `
                        <span class="restriction-tag ${r.restriction_method}">${getRestrictionLabel(r.restriction_type)} (${getMethodLabel(r.restriction_method)})</span>
                    `).join('')}
                </div>
                <div class="restriction-card-actions">
                    <button class="btn btn-sm btn-primary" onclick="editUser('${group.user_id}', '${group.username}', '${group.avatar}')">✏️ Изменить</button>
                    <button class="btn btn-sm btn-danger" onclick="removeAllUserRestrictions('${group.user_id}')">🗑️ Удалить все</button>
                </div>
            </div>
        `).join('');
    } catch (error) {
        listDiv.innerHTML = '<p class="text-muted">Ошибка загрузки ограничений</p>';
    }
}

function getRestrictionLabel(type) {
    const labels = {
        role_edit: 'Редактирование ролей',
        role_create: 'Создание ролей',
        role_delete: 'Удаление ролей',
        unban: 'Разбанивание',
        unmute: 'Размучивание',
        channel_create: 'Создание каналов',
        admin_change: 'Изменение прав админа',
        mass_action: 'Массовые действия',
        server_settings: 'Настройки сервера',
        server_rename: 'Переименование сервера',
        webhook_manage: 'Вебхуки',
        auto_ban: 'Автоматический бан',
        auto_kick: 'Автоматический кик',
        auto_demote: 'Автоматическое понижение'
    };
    return labels[type] || type;
}

function getMethodLabel(method) {
    const labels = {
        block: 'Блок',
        confirm: 'Подтверждение',
        delay: 'Задержка',
        log: 'Лог'
    };
    return labels[method] || method;
}

function editUser(userId, username, avatar) {
    showUserProfile(userId, username, username, avatar);
}

async function removeAllUserRestrictions(userId) {
    if (!confirm('Удалить все ограничения для этого пользователя?')) return;

    try {
        await fetch(`/api/security/restrictions/${userId}`, { method: 'DELETE' });
        loadRestrictionsList();
    } catch (error) {
        alert('Ошибка удаления ограничений');
    }
}

// Загрузить при инициализации
loadRestrictionsList();
</script>
