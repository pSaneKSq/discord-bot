<div class="security-tab">
    <div class="tab-header">
        <h2>🛡️ Логи защиты</h2>
        <p class="text-muted">История попыток действий и срабатываний системы защиты</p>
    </div>

    <div class="logs-controls">
        <div class="logs-filter">
            <select id="logsFilter" class="form-control">
                <option value="">Все события</option>
                <option value="allowed">✅ Разрешено</option>
                <option value="blocked">🚫 Заблокировано</option>
                <option value="pending_confirm">⏳ Ожидает подтверждения</option>
                <option value="pending_delay">⏳ Ожидает задержки</option>
            </select>
            <button id="refreshLogsBtn" class="btn btn-primary">🔄 Обновить</button>
            <button id="clearLogsBtn" class="btn btn-danger">🗑️ Очистить старые логи</button>
        </div>
    </div>

    <div class="logs-content">
        <div id="logsList" class="logs-list">
            <p class="text-muted">Загрузка...</p>
        </div>
    </div>
</div>

<style>
.security-tab {
    padding: 20px;
}

.tab-header {
    margin-bottom: 30px;
}

.tab-header h2 {
    margin: 0 0 10px 0;
    color: #ffffff;
}

.text-muted {
    color: #99aab5;
}

.logs-controls {
    background: #2f3136;
    border: 1px solid #40444b;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
}

.logs-filter {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}

.form-control {
    padding: 10px 15px;
    border: 1px solid #40444b;
    border-radius: 4px;
    background: #393c43;
    color: #ffffff;
    font-size: 14px;
    cursor: pointer;
}

.form-control:focus {
    outline: none;
    border-color: #5865f2;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
}

.btn-primary {
    background: #5865f2;
    color: #ffffff;
}

.btn-primary:hover {
    background: #4752c4;
}

.btn-danger {
    background: #ed4245;
    color: #ffffff;
}

.btn-danger:hover {
    background: #c93b3e;
}

.logs-content {
    background: #2f3136;
    border: 1px solid #40444b;
    border-radius: 8px;
    padding: 20px;
}

.logs-list {
    max-height: 600px;
    overflow-y: auto;
}

.log-entry {
    display: flex;
    gap: 15px;
    padding: 15px;
    background: #393c43;
    border: 1px solid #40444b;
    border-radius: 6px;
    margin-bottom: 10px;
}

.log-entry.blocked {
    border-left: 4px solid #ed4245;
}

.log-entry.allowed {
    border-left: 4px solid #3ba55c;
}

.log-entry.pending_confirm,
.log-entry.pending_delay {
    border-left: 4px solid #faa61a;
}

.log-timestamp {
    color: #99aab5;
    font-size: 12px;
    min-width: 150px;
    text-align: right;
}

.log-content {
    flex: 1;
}

.log-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.log-result {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
}

.log-result.allowed {
    background: #3ba55c;
    color: #ffffff;
}

.log-result.blocked {
    background: #ed4245;
    color: #ffffff;
}

.log-result.pending_confirm {
    background: #faa61a;
    color: #ffffff;
}

.log-result.pending_delay {
    background: #5865f2;
    color: #ffffff;
}

.log-user {
    color: #ffffff;
    font-weight: 500;
    font-size: 14px;
}

.log-action {
    color: #99aab5;
    font-size: 13px;
}

.log-details {
    color: #99aab5;
    font-size: 12px;
    margin-top: 6px;
}

.log-restriction {
    color: #5865f2;
    font-size: 12px;
}

.empty-logs {
    text-align: center;
    padding: 40px;
    color: #99aab5;
}
</style>

<script>
// Загрузить логи
async function loadLogs() {
    const listDiv = document.getElementById('logsList');
    const filter = document.getElementById('logsFilter').value;
    
    listDiv.innerHTML = '<p class="text-muted">Загрузка...</p>';

    try {
        let url = '/api/security/logs';
        if (filter) {
            url += `?filter=${filter}`;
        }

        const response = await fetch(url);
        const logs = await response.json();

        if (logs.length === 0) {
            listDiv.innerHTML = '<div class="empty-logs">Логи пусты</div>';
            return;
        }

        listDiv.innerHTML = logs.map(log => `
            <div class="log-entry ${log.result}">
                <div class="log-timestamp">
                    ${formatTimestamp(log.created_at)}
                </div>
                <div class="log-content">
                    <div class="log-header">
                        <span class="log-result ${log.result}">${getResultLabel(log.result)}</span>
                        <span class="log-user">${log.user_name || log.user_id}</span>
                    </div>
                    <div class="log-action">
                        ${getActionLabel(log.action_type)}
                        ${log.restriction_type ? `<span class="log-restriction"> (${getRestrictionLabel(log.restriction_type)})</span>` : ''}
                    </div>
                    ${log.details ? `<div class="log-details">${log.details}</div>` : ''}
                </div>
            </div>
        `).join('');
    } catch (error) {
        listDiv.innerHTML = '<p class="text-muted">Ошибка загрузки логов</p>';
    }
}

function formatTimestamp(timestamp) {
    const date = new Date(timestamp);
    return date.toLocaleString('ru-RU', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });
}

function getResultLabel(result) {
    const labels = {
        allowed: '✅ Разрешено',
        blocked: '🚫 Заблокировано',
        pending_confirm: '⏳ Ожидает подтверждения',
        pending_delay: '⏳ Ожидает задержки'
    };
    return labels[result] || result;
}

function getActionLabel(action) {
    const labels = {
        ROLE_UPDATE: '📝 Редактирование роли',
        GUILD_BAN_REMOVE: '🔓 Разбанивание',
        CHANNEL_DELETE: '🗑️ Удаление канала',
        GUILD_MEMBER_UPDATE: '👑 Изменение прав участника',
        WEBHOOK_CREATE: '🪝 Создание вебхука',
        WEBHOOK_DELETE: '🪝 Удаление вебхука'
    };
    return labels[action] || action;
}

function getRestrictionLabel(type) {
    const labels = {
        role_edit: 'Редактирование ролей',
        unban: 'Разбанивание',
        unmute: 'Размучивание',
        channel_delete: 'Удаление каналов',
        admin_change: 'Изменение прав админа',
        mass_action: 'Массовые действия',
        server_settings: 'Настройки сервера',
        webhook_manage: 'Вебхуки'
    };
    return labels[type] || type;
}

// Обновить логи
document.getElementById('refreshLogsBtn').addEventListener('click', loadLogs);

// Фильтр логов
document.getElementById('logsFilter').addEventListener('change', loadLogs);

// Очистить старые логи (30 дней)
document.getElementById('clearLogsBtn').addEventListener('click', async () => {
    if (!confirm('Удалить логи старше 30 дней?')) return;

    try {
        // Для реализации нужно добавить API endpoint
        alert('Функция очистки логов будет добавлена в следующем обновлении');
    } catch (error) {
        alert('Ошибка очистки логов');
    }
});

// Загрузить при инициализации
loadLogs();
</script>
